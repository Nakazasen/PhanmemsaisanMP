{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MP2027 signed content-pack manifest",
  "type": "object",
  "required": [
    "schema", "kind", "id", "version", "min_app_version", "key_id",
    "content_schema", "fiscal_year", "files"
  ],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "content"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "min_app_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "content_schema": {"const": 1},
    "fiscal_year": {"type": "integer", "minimum": 2027, "maximum": 2100},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size"],
        "additionalProperties": false,
        "properties": {
          "path": {"const": "rules.json"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "additionalProperties": false
}
